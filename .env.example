# Copy this file to ".env" in the repo root. Real environment variables override it. Never commit ".env".
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# Local language model (Ollama). If it is not running, the app still works in fallback mode.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
OLLAMA_TIMEOUT=90

# Optional overrides (defaults point at the folders already in the repo)
# HR_DATA_DIR=
# ORGPILOT_DATA_DIR=
# POLICY_DOC_DIRS=
